---
import BaseLayout from '../layouts/BaseLayout.astro';
import TheProblem from '../components/home/TheProblem.astro';
import WhatIDo from '../components/home/WhatIDo.astro';
import EngagementTiers from '../components/global/EngagementTiers.astro';
import WhyKim from '../components/home/WhyKim.astro';
import ProfessionalReferrals from '../components/home/ProfessionalReferrals.astro';
---

<BaseLayout title="Clinical Navigation & Patient Advocacy | Human Kind">
    <section class="hero">
        <div class="hero-content">
            <h1>The medical system is overwhelming. You shouldn't have to navigate it alone.</h1>
            <a href="/contact" class="hero-btn">Book a Free 20-Minute Consultation</a>
        </div>
        
        <div class="hero-image" aria-label="Kim, Patient Advocate"></div>
    </section>

    <TheProblem />

    <WhatIDo />

    <EngagementTiers />

    <WhyKim />

    <section class="providers-section" id="providers">
        <ProfessionalReferrals />
    </section>

</BaseLayout>

<style>
    .hero {
        padding: 6rem 5% 10rem;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 6rem;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
    }
    
    .hero-content h1 { 
        font-size: 4.2rem; 
        line-height: 1.1;
        margin-bottom: 3rem; 
        color: var(--navy);
    }
    
    .hero-btn {
        display: inline-block; 
        background: var(--navy); 
        color: white;
        padding: 1.2rem 3rem;
        text-decoration: none; 
        font-weight: 600; 
        text-transform: uppercase; 
        letter-spacing: 2px;
        font-size: 0.85rem; 
        box-shadow: 15px 15px 0 var(--bg-beige); /* Adjusted to match a warm background */
        transition: all 0.3s ease;
    }
    
    .hero-btn:hover { 
        background: var(--royal-blue); 
        transform: translate(-5px, -5px); 
        box-shadow: 20px 20px 0 var(--bg-beige);
    }
    
    .hero-image {
        width: 100%; 
        height: 70vh;
        background: url('/home-banner.png') center/cover no-repeat;
        border-radius: 4px;
    }

    .providers-section {
        background-color: var(--bg-beige); /* Gives the B2B section its own distinct feel */
        padding: 6rem 5%;
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    /* Responsive Breakpoints */
    @media (max-width: 960px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 4rem;
            padding: 4rem 5% 6rem;
        }
        .hero-content h1 {
            font-size: 3.2rem;
        }
        .hero-image {
            height: 50vh;
        }
    }
</style>