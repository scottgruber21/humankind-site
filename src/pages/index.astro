---
import BaseLayout from '../layouts/BaseLayout.astro';
import DistinctionBadges from '../components/home/DistinctionBadges.astro';
import ImpactStudy from '../components/home/ImpactStudy.astro';
import ProcessSteps from '../components/home/ProcessSteps.astro';
import ProfessionalReferrals from '../components/home/ProfessionalReferrals.astro';
---

<BaseLayout title="Clinical Navigation & Patient Advocacy">
    <section class="hero">
        <div class="hero-content">
            <h1>Your healthcare ally when navigating cancer treatment and complex care.</h1>
            <p>I sit on your side of the table, speak your doctors' language, and make sure nothing falls through the cracks.</p>
            <a href="/contact" class="hero-btn">Let's Get Started</a>
        </div>
        <div class="hero-image"></div>
    </section>

    <DistinctionBadges />
    <ImpactStudy />

    <section class="bottom-section">
        <ProcessSteps />
        <ProfessionalReferrals />
    </section>
</BaseLayout>

<style>
    .hero {
        padding: 6rem 5% 10rem;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 6rem;
        align-items: center;
    }
    .hero-content h1 { font-size: 4.2rem; line-height: 1; margin-bottom: 2rem; }
    .hero-content p { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 3rem; max-width: 480px; }
    .hero-btn {
        display: inline-block; background: var(--navy); color: white; padding: 1.2rem 3rem;
        text-decoration: none; font-weight: 600; text-transform: uppercase; letter-spacing: 2px;
        font-size: 0.85rem; box-shadow: 15px 15px 0 var(--white); transition: all 0.3s ease;
    }
    .hero-btn:hover { background: var(--royal-blue); transform: translate(-5px, -5px); box-shadow: 20px 20px 0 var(--white); }
    .hero-image {
        width: 100%; height: 75vh;
        background: url('home-banner.png') center/cover;
    }

    /* Bottom Grid Wrapper */
    .bottom-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 10rem 5%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8rem;
        border-top: 1px solid #eee;
    }

  /* Responsive Breakpoints */
    @media (max-width: 960px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 4rem;
            padding: 4rem 5% 6rem;
        }
        .hero-content h1 {
            font-size: 3rem;
        }
        .hero-image {
            height: 50vh;
        }
        .bottom-section {
            grid-template-columns: 1fr;
            gap: 4rem;
            padding: 6rem 5%;
        }
    }
</style>