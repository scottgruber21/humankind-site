---
import BaseLayout from "../layouts/BaseLayout.astro";
import providersContent from "../data/providers.json";
---

<BaseLayout title="For Professionals | Human Kind Advocates">
    <header class="providers-hero">
        <div class="hero-container">
            <span class="eyebrow">{providersContent.hero.eyebrow}</span>
            <h1>{providersContent.hero.heading}</h1>
            <p>{providersContent.hero.body}</p>
        </div>
    </header>

    <section class="audiences">
        <div class="container">
            <div class="audience-grid">
                {providersContent.audiences.map((audience) => (
                    <div class="audience-card">
                        <h3>{audience.heading}</h3>
                        <p>{audience.body}</p>
                        <p><strong>How I help:</strong> {audience.help}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="professional-faq">
        <div class="container">
            <div class="faq-header">
                <h2>{providersContent.faq.heading}</h2>
                <p>{providersContent.faq.intro}</p>
            </div>

            <div class="faq-grid">
                {providersContent.faq.items.map((item) => (
                    <div class="faq-item">
                        <h4>{item.heading}</h4>
                        <p>{item.body}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="provider-cta">
        <div class="container text-center">
            <h2>{providersContent.cta.heading}</h2>
            <p>{providersContent.cta.body}</p>
            <a href="/contact" class="btn-solid">{providersContent.cta.buttonText}</a>
        </div>
    </section>
</BaseLayout>

<style>
    .providers-hero {
        padding: 8rem 5% 6rem;
        background: var(--navy);
        color: var(--white);
        text-align: center;
    }

    .hero-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .eyebrow {
        font-family: "Inter", sans-serif;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
        display: block;
        margin-bottom: 1.5rem;
    }

    .providers-hero h1 {
        color: white;
        font-family: "Cormorant Garamond", serif;
        font-size: 4rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .providers-hero p {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.6;
    }

    .audiences {
        padding: 6rem 5%;
        background: var(--bg-beige);
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .audience-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
    }

    .audience-card {
        background: var(--white);
        padding: 4rem;
        border-top: 4px solid var(--royal-blue);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .audience-card h3 {
        font-size: 1.8rem;
        color: var(--navy);
        margin-bottom: 1.5rem;
    }

    .audience-card p {
        font-size: 1.1rem;
        color: var(--text-dark);
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }

    .audience-card strong {
        color: var(--navy);
        font-weight: 600;
    }

    .professional-faq {
        padding: 8rem 5%;
        background: var(--white);
    }

    .faq-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .faq-header h2 {
        font-size: 3rem;
        color: var(--navy);
        margin-bottom: 1rem;
    }

    .faq-header p {
        font-size: 1.2rem;
        color: var(--text-muted);
    }

    .faq-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem;
    }

    .faq-item h4 {
        font-size: 1.8rem;
        color: var(--navy);
        margin-bottom: 1rem;
        border-bottom: 1px solid rgba(10, 34, 64, 0.1);
        padding-bottom: 0.5rem;
    }

    .faq-item p {
        font-size: 1.05rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .provider-cta {
        padding: 6rem 5% 8rem;
        background: var(--bg-beige);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .text-center {
        text-align: center;
        max-width: 600px;
    }

    .provider-cta h2 {
        font-family: "Cormorant Garamond", serif;
        font-size: 3.5rem;
        color: var(--navy);
        font-style: italic;
        margin-bottom: 1rem;
    }

    .provider-cta p {
        font-size: 1.15rem;
        color: var(--text-dark);
        margin-bottom: 3rem;
    }

    .btn-solid {
        display: inline-block;
        background: var(--navy);
        color: var(--white);
        padding: 1rem 2.5rem;
        text-decoration: none;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: background 0.3s ease;
    }

    .btn-solid:hover {
        background: var(--royal-blue);
    }

    @media (max-width: 960px) {
        .providers-hero h1 {
            font-size: 3rem;
        }

        .audience-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .audience-card {
            padding: 2.5rem;
        }

        .faq-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }
</style>
