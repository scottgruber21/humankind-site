---
import BaseLayout from "../layouts/BaseLayout.astro";
import aboutContent from "../data/about.json";
---

<BaseLayout
    title="About Kim Ely, PA-C | Clinical Navigation & Patient Advocacy"
    description="Learn about Kim Ely's 15+ years of clinical oncology and bone marrow transplant experience at Johns Hopkins and CHLA, and her mission in private patient advocacy."
>
    <header class="about-hero">
        <div class="hero-container">
            <h4>{aboutContent.hero.eyebrow}</h4>
            <h1>{aboutContent.hero.heading}</h1>
            <p class="subtitle">{aboutContent.hero.subtitle}</p>
        </div>
    </header>

    <section class="story-section">
        <div class="story-container">
            <div class="story-content">
                <h2>{aboutContent.story.heading}</h2>
                {aboutContent.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="story-image"></div>
        </div>
    </section>

    <section class="experience-section">
        <div class="experience-container">
            <h2>{aboutContent.experience.heading}</h2>
            <p class="section-lead">{aboutContent.experience.lead}</p>

            <div class="timeline-grid">
                {aboutContent.experience.items.map((item) => (
                    <div class="timeline-item">
                        <div class="badge">{item.badge}</div>
                        <h3>{item.organization}</h3>
                        <h4>{item.role}</h4>
                        <p>{item.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="mission-cta">
        <div class="cta-container">
            <h2>{aboutContent.cta.heading}</h2>
            <p>{aboutContent.cta.body}</p>
            <a href="/contact" class="btn-primary">{aboutContent.cta.buttonText}</a>
        </div>
    </section>
</BaseLayout>

<style>
    .about-hero {
        padding: 8rem 5% 4rem;
        text-align: center;
        background: var(--white);
    }

    .hero-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .about-hero h4 {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.8rem;
        font-family: "Inter", sans-serif;
        font-weight: 600;
        color: var(--royal-blue);
        margin-bottom: 1rem;
    }

    .about-hero h1 {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        line-height: 1.1;
    }

    .about-hero .subtitle {
        font-size: 1.25rem;
        color: var(--text-dark);
        line-height: 1.5;
    }

    .story-section {
        padding: 4rem 5% 8rem;
        background: var(--white);
    }

    .story-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 6rem;
        align-items: center;
    }

    .story-content h2 {
        font-size: 2.5rem;
        margin-bottom: 2rem;
        line-height: 1.2;
    }

    .story-content p {
        font-size: 1.1rem;
        color: var(--text-muted);
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }

    .story-image {
        width: 100%;
        height: 55vh;
        background: url("/kim.jpg") center/cover;
        background-color: var(--bg-beige);
        box-shadow: 15px 15px 0 var(--bg-beige);
    }

    .experience-section {
        background: var(--bg-beige);
        padding: 8rem 5%;
        border-top: 1px solid #eee;
    }

    .experience-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .experience-section h2 {
        font-size: 3rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .section-lead {
        font-size: 1.2rem;
        color: var(--text-dark);
        max-width: 750px;
        margin-bottom: 5rem;
        line-height: 1.6;
    }

    .timeline-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
    }

    .timeline-item {
        background: var(--white);
        padding: 3.5rem 3rem;
        border-top: 4px solid var(--navy);
        position: relative;
    }

    .timeline-item .badge {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: var(--royal-blue);
        background: rgba(65, 105, 225, 0.08);
        padding: 0.3rem 0.8rem;
        margin-bottom: 1.5rem;
    }

    .timeline-item h3 {
        font-size: 1.6rem;
        color: var(--navy);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }

    .timeline-item h4 {
        font-size: 0.95rem;
        color: var(--text-dark);
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .timeline-item p {
        font-size: 1rem;
        color: var(--text-muted);
        line-height: 1.7;
    }

    .mission-cta {
        padding: 9rem 5%;
        text-align: center;
        background: var(--white);
        border-top: 1px solid #eee;
    }

    .cta-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .mission-cta h2 {
        font-size: 2.8rem;
        margin-bottom: 2rem;
        line-height: 1.2;
    }

    .mission-cta p {
        font-size: 1.2rem;
        color: var(--text-muted);
        line-height: 1.7;
        margin-bottom: 3.5rem;
    }

    .btn-primary {
        display: inline-block;
        background: var(--navy);
        color: white;
        padding: 1.2rem 3.5rem;
        text-decoration: none;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        box-shadow: 12px 12px 0 var(--bg-beige);
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: var(--royal-blue);
        transform: translate(-3px, -3px);
        box-shadow: 18px 18px 0 var(--bg-beige);
    }

    @media (max-width: 960px) {
        .about-hero {
            padding: 5rem 5% 3rem;
        }

        .about-hero h1 {
            font-size: 2.8rem;
        }

        .story-container,
        .timeline-grid {
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        .story-image {
            height: 40vh;
        }

        .experience-section,
        .mission-cta {
            padding: 5rem 5%;
        }

        .experience-section h2,
        .story-content h2,
        .mission-cta h2 {
            font-size: 2.2rem;
        }

        .section-lead {
            margin-bottom: 3rem;
        }

        .timeline-item {
            padding: 2.5rem 2rem;
        }
    }
</style>
