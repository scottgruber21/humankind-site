---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The requested clinical advocacy resource could not be found. Return to Human Kind Advocates.">
    <section class="error-section">
        <div class="error-container">
            <span class="error-code">404</span>
            <h1>Navigation Diverged</h1>
            <p>The page or clinical resource you are looking for is unavailable, has been moved, or does not exist. Let's get your navigation back on course.</p>
            
            <div class="action-links">
                <a href="/" class="btn-primary">Return Home</a>
                <a href="/services" class="btn-outline">Review Services</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .error-section {
        padding: 10rem 5%;
        background: var(--bg-beige);
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .error-container {
        max-width: 600px;
        margin: 0 auto;
    }

    .error-code {
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: var(--royal-blue);
        display: block;
        margin-bottom: 1rem;
    }

    .error-container h1 {
        font-size: 4rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .error-container p {
        font-size: 1.15rem;
        color: var(--text-muted);
        margin-bottom: 3rem;
    }

    .action-links {
        display: flex;
        gap: 2rem;
        justify-content: center;
        align-items: center;
    }

    /* Primary Button custom matching home styling */
    .btn-primary {
        display: inline-block;
        background: var(--navy);
        color: white;
        padding: 1.2rem 3rem;
        text-decoration: none;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        box-shadow: 15px 15px 0 var(--white);
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: var(--royal-blue);
        transform: translate(-5px, -5px);
        box-shadow: 20px 20px 0 var(--white);
    }

    /* Outline Button custom matching services styling */
    .btn-outline {
        display: inline-block;
        border: 1px solid var(--navy);
        padding: 1.2rem 3rem;
        text-decoration: none;
        color: var(--navy);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-outline:hover {
        background: var(--royal-blue);
        border-color: var(--royal-blue);
        color: white;
    }

    /* Responsive scaling */
    @media (max-width: 768px) {
        .error-section {
            padding: 6rem 5%;
        }
        .error-container h1 {
            font-size: 2.6rem;
        }
        .error-container p {
            font-size: 1rem;
            margin-bottom: 2.5rem;
        }
        .action-links {
            flex-direction: column;
            gap: 1.5rem;
            width: 100%;
        }
        .btn-primary, .btn-outline {
            width: 100%;
            text-align: center;
        }
    }
</style>