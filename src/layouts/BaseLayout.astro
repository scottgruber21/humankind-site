---
import '../styles/global.css';
import Nav from '../components/global/Nav.astro';
import Footer from '../components/global/Footer.astro';
import SEO from '../components/global/SEO.astro'; // Import the new SEO manager

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const { 
    title, 
    description = "Expert clinical navigation and private patient advocacy for high-stakes medical situations.", 
    image 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <SEO title={title} description={description} image={image} />
</head>
<body>
    <Nav />
    <main>
        <slot />
    </main>
    <Footer />
</body>
</html>