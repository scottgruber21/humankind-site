---
import BaseLayout from './BaseLayout.astro';

interface Props {
    frontmatter: {
        title: string;
        date: Date;
        category: string;
        excerpt: string;
    };
}

const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.excerpt}>
    <article class="article-container">
        <header class="article-header">
            <span class="meta">{formattedDate} &bull; {frontmatter.category}</span>
            <h1>{frontmatter.title}</h1>
        </header>

        <div class="content-wrap">
            <div class="content-body">
                <slot /> </div>

            <div class="author-card">
                <div class="author-img"></div>
                <div class="author-text">
                    <h4>Kim Gruber, PA-C</h4>
                    <p>With 15 years of clinical experience in oncology and bone marrow transplant, Kim provides expert navigation for families facing complex medical situations.</p>
                </div>
            </div>

            <div class="integrity-footer">
                Clinical Integrity: No referral fees are ever paid or accepted.
            </div>
        </div>
    </article>
</BaseLayout>

<style is:global>
    /* Scoped globally to target elements generated inside Markdown */
    .content-body p {
        margin-bottom: 2rem;
        font-size: 1.15rem;
        color: #333;
        line-height: 1.8;
    }
    .content-body blockquote { 
        font-family: 'Cormorant Garamond', serif; 
        font-size: 2.2rem; 
        font-style: italic; 
        color: var(--royal-blue); 
        margin: 4rem 0; 
        padding-left: 2rem; 
        border-left: 2px solid var(--royal-blue);
        line-height: 1.3;
    }
    @media (max-width: 768px) {
        .content-body blockquote {
            font-size: 1.6rem;
            margin: 2.5rem 0;
        }
    }
</style>

<style>
    .article-container {
        background: var(--white);
        padding-bottom: 8rem;
    }
    .article-header {
        padding: 8rem 5% 4rem;
        text-align: center;
        max-width: 900px;
        margin: 0 auto;
    }
    .meta {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #888;
        margin-bottom: 1rem;
        display: block;
    }
    .article-header h1 {
        font-size: 4rem;
        line-height: 1.1;
    }
    .content-wrap {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 5%;
    }

    .author-card { 
        margin-top: 6rem; 
        padding: 3rem; 
        background: var(--bg-beige); 
        display: flex; 
        gap: 2rem; 
        align-items: center; 
    }
    .author-img { width: 80px; height: 80px; background: #ddd; border-radius: 50%; flex-shrink: 0; }
    .author-text h4 { font-size: 1.8rem; margin-bottom: 0.5rem; }
    .author-text p { font-size: 0.9rem; color: #666; line-height: 1.5; margin: 0; }

    .integrity-footer { 
        margin-top: 4rem; 
        font-size: 0.8rem; 
        text-align: center; 
        color: var(--royal-blue); 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        opacity: 0.7;
    }

    @media (max-width: 768px) {
        .article-header { padding: 4rem 5% 2rem; }
        .article-header h1 { font-size: 2.4rem; }
        .author-card { flex-direction: column; text-align: center; padding: 2rem 1.5rem; gap: 1.5rem; margin-top: 4rem; }
    }
</style>