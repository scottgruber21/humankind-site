---
---
<footer>

    <div>
        <img id="footer-icon" src="/hka_icon.svg" alt="Human Kind Advocates Logo" style="width: 100px; height: auto;">
        <span class="brand-name">Human Kind Advocates</span>
        <p style="font-weight: 300; opacity: 0.8;">Clinical Patient Advocacy with Compassion</p>
    </div>
    <p style="font-size: 0.8rem; opacity: 0.6;">&copy; {new Date().getFullYear()}. All rights reserved.</p>
</footer>

<style>
    #footer-icon {
        margin-right: 1rem;
        display: block;
    }

    footer {
        padding: 6rem 5%;
        background: var(--navy);
        color: var(--white);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }
    footer .brand-name {
        color: var(--white);
        font-size: 2rem;
        margin-bottom: 0.5rem;
        font-family: 'Cormorant Garamond', serif;
    }
</style>