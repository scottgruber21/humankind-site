---
---

<section class="engagement-tiers" id="tiers">
    <div class="tiers-container">
        
        <div class="tier-row">
            <div class="tier-meta">
                <h4>Entry</h4>
                <h2>Clarity Consultation</h2>
                <div class="tier-price">$500 One-Time</div>
            </div>
            <div class="tier-details">
                <p>
                    The clearest 90 minutes you'll spend on this diagnosis. Best
                    for early-stage navigation or second-opinion decisions.
                </p>
            </div>
            <div class="tier-cta">
                <a href="/contact" class="btn-outline">Request Consult</a>
            </div>
        </div>

        <div class="tier-row">
            <div class="tier-meta">
                <h4>Retainer</h4>
                <h2>Active Advocacy</h2>
                <div class="tier-price">$2,500 / Month</div>
            </div>
            <div class="tier-details">
                <p>
                    Ongoing advocacy for clients navigating active treatment or
                    complex care transitions.
                </p>
            </div>
            <div class="tier-cta">
                <a href="/contact" class="btn-outline">Inquire</a>
            </div>
        </div>

        <div class="tier-row">
            <div class="tier-meta">
                <h4>Premium</h4>
                <h2>White Glove</h2>
                <div class="tier-price">$4,500 / Month</div>
            </div>
            <div class="tier-details">
                <p>
                    Full-service advocacy for high-complexity cases or family
                    members who need a dedicated ally fully in their corner.
                </p>
            </div>
            <div class="tier-cta">
                <a href="/contact" class="btn-outline">Contact Me</a>
            </div>
        </div>
        
    </div>
</section>

<style>
    .engagement-tiers {
        background: var(--bg-beige);
        padding: 8rem 5%;
    }

    .tiers-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .tier-row {
        display: grid;
        grid-template-columns: 1.5fr 2.5fr 1fr;
        gap: 4rem;
        padding: 4rem 0;
        border-bottom: 1px solid rgba(10, 34, 64, 0.15); /* Softened the border slightly */
        align-items: center; /* Changed from flex-start to center since content is shorter */
    }

    .tier-row:last-child {
        border-bottom: none;
    }

    .tier-meta h4 {
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.8rem;
        font-family: "Inter", sans-serif;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    .tier-meta h2 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
        line-height: 1.1;
        color: var(--navy);
    }

    .tier-price {
        font-family: "Cormorant Garamond", serif;
        font-size: 1.8rem;
        color: var(--royal-blue);
        font-style: italic;
    }

    .tier-details p {
        font-size: 1.25rem; /* Bumped up font size slightly to fill space better */
        line-height: 1.6;
        color: var(--text-dark);
        margin: 0;
        max-width: 90%;
    }

    .tier-cta {
        text-align: right;
    }

    .btn-outline {
        display: inline-block;
        border: 1px solid var(--navy);
        padding: 1rem 2rem;
        text-decoration: none;
        color: var(--navy);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-outline:hover {
        background: var(--royal-blue);
        border-color: var(--royal-blue);
        color: white;
    }

    /* Responsive Breakpoints */
    @media (max-width: 960px) {
        .tier-row {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            padding: 3rem 0;
            text-align: center; /* Center everything on mobile */
            align-items: center;
        }
        .tier-meta h2 {
            font-size: 2.5rem;
        }
        .tier-cta {
            text-align: center;
            margin-top: 1rem;
        }
        .tier-details p {
            max-width: 100%;
            font-size: 1.1rem;
        }
    }
</style>