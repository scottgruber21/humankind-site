---
interface Props {
    content: {
        heading: string;
        lead: string;
        body: string;
        punchline: string;
    };
}

const { content } = Astro.props;
---

<section class="the-problem" id="problem">
    <div class="container">
        <h2>{content.heading}</h2>

        <div class="content">
            <p class="lead">{content.lead}</p>
            <p>{content.body}</p>
            <p class="punchline">{content.punchline}</p>
        </div>
    </div>
</section>

<style>
    .the-problem {
        padding: 8rem 5%;
        background-color: var(--white);
        display: flex;
        justify-content: center;
    }

    .container {
        max-width: 800px;
        text-align: center;
    }

    h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 3.2rem;
        color: var(--navy);
        line-height: 1.1;
        margin-bottom: 3rem;
        font-style: italic;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    p.lead {
        font-size: 1.3rem;
        color: var(--navy);
        line-height: 1.6;
        font-weight: 500;
        margin: 0;
    }

    p {
        font-size: 1.15rem;
        color: var(--text-dark);
        line-height: 1.6;
        margin: 0;
    }

    p.punchline {
        margin-top: 1.5rem;
        font-weight: 600;
        color: var(--royal-blue);
        font-size: 1.25rem;
    }

    @media (max-width: 768px) {
        .the-problem {
            padding: 5rem 5%;
        }
        h2 {
            font-size: 2.4rem;
            margin-bottom: 2rem;
        }
        p.lead {
            font-size: 1.15rem;
        }
        p,
        p.punchline {
            font-size: 1.05rem;
        }
    }
</style>
