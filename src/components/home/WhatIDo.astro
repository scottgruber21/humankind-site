<section class="what-i-do" id="services">
    <div class="container">
        <div class="section-header">
            <h2>What I Do</h2>
            <p>I step in to manage the clinical details so you can focus on your family.</p>
        </div>

        <div class="services-grid">
            
            <div class="service-card">
                <div class="icon-placeholder">01</div>
                <h3>Record Review & Translation</h3>
                <p>I read every page of your medical records and translate what matters into plain language.</p>
            </div>

            <div class="service-card">
                <div class="icon-placeholder">02</div>
                <h3>Second Opinion Coordination</h3>
                <p>I know which institutions lead in which specialties. I facilitate the right second opinion, fast.</p>
            </div>

            <div class="service-card">
                <div class="icon-placeholder">03</div>
                <h3>Provider Communication</h3>
                <p>I communicate directly with your care team in clinical language so nothing is lost in translation.</p>
            </div>

            <div class="service-card">
                <div class="icon-placeholder">04</div>
                <h3>Appointment Navigation</h3>
                <p>I prepare you before every appointment and debrief with you after so you understand your options.</p>
            </div>

        </div>
    </div>
</section>

<style>
    .what-i-do {
        padding: 8rem 5%;
        background-color: var(--bg-beige); /* Warm background to contrast with The Problem section */
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .section-header h2 {
        font-size: 3rem;
        color: var(--navy);
        margin-bottom: 1rem;
    }

    .section-header p {
        font-size: 1.2rem;
        color: var(--text-muted);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 3rem;
    }

    .service-card {
        background: var(--white);
        padding: 3rem;
        border-radius: 4px;
        border: 1px solid rgba(10, 34, 64, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: 10px 10px 0 var(--royal-blue); /* Playful but professional shadow tying back to the hero button */
    }

    .icon-placeholder {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 2rem;
        color: var(--royal-blue);
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .service-card h3 {
        font-size: 1.4rem;
        color: var(--navy);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .service-card p {
        font-size: 1.05rem;
        color: var(--text-dark);
        line-height: 1.6;
        margin: 0;
    }

    /* Responsive Breakpoints */
    @media (max-width: 960px) {
        .services-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .what-i-do {
            padding: 5rem 5%;
        }
        .section-header {
            margin-bottom: 3rem;
        }
        .section-header h2 {
            font-size: 2.5rem;
        }
        .service-card {
            padding: 2rem;
        }
    }
</style>