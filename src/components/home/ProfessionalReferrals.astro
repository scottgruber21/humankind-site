---
interface Props {
    content: {
        heading: string;
        intro: string;
        description: string;
        quote: string;
        author: string;
    };
}

const { content } = Astro.props;
---

<div class="partners" id="partners">
    <h2>{content.heading}</h2>
    <p class="intro-p">{content.intro}</p>
    <p class="desc-p">{content.description}</p>

    <div class="integrity-box">
        <p class="quote">“{content.quote}”</p>
        <span class="author">{content.author}</span>
    </div>
</div>

<style>
    .partners h2 { font-size: 2.8rem; margin-bottom: 2rem; }
    .intro-p { font-size: 1.1rem; margin-bottom: 1.5rem; color: var(--text-dark); }
    .desc-p { margin-bottom: 2rem; color: var(--text-muted); font-size: 0.95rem; }
    .integrity-box { padding: 2rem; border: 1px solid var(--royal-blue); background: var(--white); }
    .quote { font-style: italic; color: var(--royal-blue); margin-bottom: 1rem; font-size: 1.05rem; }
    .author { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; font-style: italic; color: var(--navy); }
    @media (max-width: 768px) {
        .partners h2 { font-size: 2.2rem; margin-bottom: 1.5rem; }
        .integrity-box { padding: 1.5rem; }
    }
</style>
