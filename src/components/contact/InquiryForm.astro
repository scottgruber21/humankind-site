---
interface Props {
    content: {
        heading: string;
        intro: string;
        buttonText: string;
    };
}

const { content } = Astro.props;
---

<section class="inquiry-section">
    <div class="form-container">
        <h2>{content.heading}</h2>
        <p class="form-subtitle">{content.intro}</p>

        <div class="privacy-notice" id="privacy-guidance" role="note">
            <strong>Please keep this form general.</strong>
            Do not include diagnoses, symptoms, treatment details, medications,
            insurance information, medical records, or other sensitive health
            information.
        </div>

       <form
    name="consultation-request"
    method="POST"
    action="/thank-you/"
    class="intake-form"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
>
    <input
        type="hidden"
        name="form-name"
        value="consultation-request"
    />

    <p class="honeypot">
        <label>
            Leave this field blank:
            <input name="bot-field" />
        </label>
    </p>
            <div class="form-grid">
                <div class="form-group">
                    <label for="name">Your Full Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        autocomplete="name"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        autocomplete="email"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="phone">
                        Phone Number
                        <span class="optional">(optional)</span>
                    </label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        autocomplete="tel"
                    />
                    <span class="field-help">
                        Please include a number if you prefer to be contacted by phone.
                    </span>
                </div>

                <div class="form-group">
                    <label for="contact-method">Preferred Contact Method</label>
                    <select
                        id="contact-method"
                        name="contactMethod"
                        required
                    >
                        <option value="" disabled selected>Select option</option>
                        <option value="email">Email</option>
                        <option value="phone">Phone</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="relationship">How Are You Reaching Out?</label>
                    <select
                        id="relationship"
                        name="relationship"
                        required
                    >
                        <option value="" disabled selected>Select option</option>
                        <option value="self">For myself</option>
                        <option value="family">
                            For a family member or friend
                        </option>
                        <option value="professional">
                            As a referring professional
                        </option>
                        <option value="general">
                            With a general question
                        </option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="availability">
                        Best Time to Reach You
                        <span class="optional">(optional)</span>
                    </label>
                    <input
                        type="text"
                        id="availability"
                        name="availability"
                        maxlength="100"
                        placeholder="For example: weekday afternoons"
                    />
                </div>
            </div>

            <label class="acknowledgment">
                <input
                    type="checkbox"
                    name="privacyAcknowledgment"
                    required
                />
                <span>
                    I understand that this form is only for requesting contact
                    and should not contain sensitive health information.
                </span>
            </label>

            <div class="form-submit">
                <button type="submit" class="btn-submit">
                    {content.buttonText}
                </button>
            </div>
        </form>
    </div>
</section>

<style>

.honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
}

    .inquiry-section {
        padding: 8rem 5%;
        background: var(--white);
    }

    .form-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .form-container h2 {
        font-size: 3.5rem;
        line-height: 1.1;
        margin-bottom: 1rem;
    }

    .form-subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        line-height: 1.7;
        margin-bottom: 2rem;
        max-width: 680px;
    }

    .privacy-notice {
        padding: 1.25rem 1.5rem;
        margin-bottom: 3rem;
        border-left: 4px solid var(--royal-blue);
        background: var(--bg-beige);
        color: var(--text-dark);
        line-height: 1.6;
    }

    .privacy-notice strong {
        color: var(--navy);
    }

    .intake-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-group label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        color: var(--navy);
    }

    .optional {
        color: var(--text-muted);
        font-weight: 400;
        text-transform: none;
        letter-spacing: 0;
    }

    .field-help {
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.4;
    }

    .form-group input,
    .form-group select {
        padding: 1rem;
        border: 1px solid rgba(10, 34, 64, 0.2);
        background: var(--bg-beige);
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        color: var(--text-dark);
        border-radius: 0;
        transition: border-color 0.3s ease;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: var(--royal-blue);
    }

    .acknowledgment {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        color: var(--text-dark);
        font-size: 0.95rem;
        line-height: 1.5;
        cursor: pointer;
    }

    .acknowledgment input {
        flex: 0 0 auto;
        margin-top: 0.25rem;
    }

    .form-submit {
        margin-top: 1rem;
    }

    .btn-submit {
        display: inline-block;
        background: var(--navy);
        color: white;
        border: none;
        padding: 1.2rem 3rem;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        box-shadow: 15px 15px 0 var(--bg-beige);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-submit:hover {
        background: var(--royal-blue);
        transform: translate(-5px, -5px);
        box-shadow: 20px 20px 0 var(--bg-beige);
    }

    .btn-submit:focus-visible {
        outline: 3px solid var(--royal-blue);
        outline-offset: 4px;
    }

    @media (max-width: 768px) {
        .inquiry-section {
            padding: 4rem 5%;
        }

        .form-container h2 {
            font-size: 2.4rem;
        }

        .form-subtitle {
            font-size: 1rem;
        }

        .privacy-notice {
            margin-bottom: 2.5rem;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .btn-submit {
            width: 100%;
            text-align: center;
        }
    }
</style>